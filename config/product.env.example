# Second Brain product-mode defaults.
# Copy to config/product.env for a bundled build, or let product mode create
# a private config file under the product home on first launch.

SECOND_BRAIN_PRODUCT_MODE=1
SECOND_BRAIN_EMBEDDED_HERMES=1

# Private Hermes API exposed only to this product.
SECOND_BRAIN_HERMES_PORT=18643
HERMES_API_TARGET=http://127.0.0.1:18643

# The installer/first-run flow should collect cloud model credentials and
# write them into the product-private Hermes config, not into the user's
# global ~/.hermes directory.
