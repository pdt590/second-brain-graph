# ============================================
# Second Brain LLM-Wiki Graph 环境变量配置
# ============================================
# 复制本文件为 .env，填入实际值后生效
# cp .env.example .env
# ============================================

# --------------------------------------------
# 认证设置
# --------------------------------------------

# 管理员用户名（默认 admin）
SECOND_BRAIN_ADMIN_USER=admin

# 管理员密码
# 如果不设置，首次启动时会自动生成并打印到控制台
SECOND_BRAIN_ADMIN_PASSWORD=

# 凭据存储路径（默认 <项目目录>/data/auth.json）
SECOND_BRAIN_AUTH_FILE=

# --------------------------------------------
# Hermes API 连接
# --------------------------------------------

# Hermes API Server 认证 Key
# 来源：~/.hermes/.env 中的 API_SERVER_KEY
API_SERVER_KEY=

# Hermes API Server 地址（默认自动探测：日志解析 → 端口扫描 8643/8642）
# 设置后跳过自动探测，直接使用该地址
HERMES_API_TARGET=

# --------------------------------------------
# Wiki 知识库
# --------------------------------------------

# Wiki 知识库目录（默认 ~/.hermes/llm-wiki）
# wiki 目录不存在时系统会正常启动，但图谱会显示为空
HERMES_WIKI_DIR=~/.hermes/llm-wiki

# --------------------------------------------
# 生产服务器
# --------------------------------------------
# 仅在使用 node server/second-brain-server.mjs 时生效

# 服务器监听端口（默认 3030）
SECOND_BRAIN_PORT=3030

# 服务器监听地址（默认 127.0.0.1，如需公网访问可设为 0.0.0.0）
SECOND_BRAIN_HOST=127.0.0.1
