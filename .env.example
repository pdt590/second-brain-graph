# ============================================
# Second Brain LLM-Wiki Graph environment configuration
# ============================================
# Copy this file to .env and enter your configuration values.
# cp .env.example .env
# ============================================

# --------------------------------------------
# Authentication settings
# --------------------------------------------

# Administrator username (default: admin)
SECOND_BRAIN_ADMIN_USER=admin

# Administrator password
# If unset, a password is generated on first startup and printed to the console.
SECOND_BRAIN_ADMIN_PASSWORD=

# Credentials path (default: <project directory>/data/auth.json)
SECOND_BRAIN_AUTH_FILE=

# --------------------------------------------
# Hermes API connection
# --------------------------------------------

# Hermes API server authentication key
# Source: API_SERVER_KEY in ~/.hermes/.env
API_SERVER_KEY=

# Hermes API server URL (auto-detection: logs, then ports 8643/8642)
# Use this URL instead of automatic detection.
HERMES_API_TARGET=

# --------------------------------------------
# Wiki knowledge base
# --------------------------------------------

# Wiki directory (default: ~/.hermes/llm-wiki)
# The application starts if the wiki directory is missing, but the graph will be empty.
HERMES_WIKI_DIR=~/.hermes/llm-wiki

# --------------------------------------------
# Production server
# --------------------------------------------
# Applies only when running node server/second-brain-server.mjs

# Server listening port (default: 3030)
SECOND_BRAIN_PORT=3030

# Server listening address (default: 127.0.0.1; use 0.0.0.0 for external access)
SECOND_BRAIN_HOST=127.0.0.1
