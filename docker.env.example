# ============================================
# Second Brain Docker environment configuration
# ============================================
# Copy this file to .env and enter your configuration values.
# cp docker.env.example .env
# ============================================

# --------------------------------------------
# Wiki knowledge base
# --------------------------------------------
# Absolute wiki directory path on the host
HERMES_WIKI_DIR=$HOME/wiki

# --------------------------------------------
# Authentication settings
# --------------------------------------------
# Administrator username (default: admin)
SECOND_BRAIN_ADMIN_USER=admin
# Administrator password (generated on first startup if empty)
SECOND_BRAIN_ADMIN_PASSWORD=

# --------------------------------------------
# Hermes API connection
# --------------------------------------------
# Hermes API server authentication key
API_SERVER_KEY=
# Hermes API URL (automatically detected if empty)
HERMES_API_TARGET=

# --------------------------------------------
# Network
# --------------------------------------------
# Published host port
SECOND_BRAIN_PORT=3030
